{
  "name": "openapi",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "gen": "npm-run-all gen:msr gen:api",
    "gen:msr": "openapi-generator-cli generate -i ./msr.openapi.yml -g typescript --additional-properties=platform=deno -o generated-msr/",
    "postgen:msr": "rimraf ../core/src/generated-msr && mv -f ./generated-msr ../core/src",
    "gen:api": "openapi-generator-cli generate -i ./operation-real-wave.openapi.yml -g typescript -o generated-orw/",
    "postgen:api": "rimraf ../web/app/_src/generated-orw && mv -f ./generated-orw ../web/app/_src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.7",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1"
  }
}
