{
  "name": "core",
  "scripts": {
    "start": "deno task start",
    "openapi": "openapi-generator-cli",
    "tsp": "tsp",
    "tsp:compile": "run-p tsp:compile:*",
    "tsp:compile:msr": "tsp compile ./tsp/msr.tsp --options \"@typespec/openapi3.output-file=msr.openapi.yaml\" --config ./tspconfig.yaml",
    "tsp:compile:core": "tsp compile ./tsp/core.tsp --options \"@typespec/openapi3.output-file=core.openapi.yaml\" --config ./tspconfig.yaml",
    "pregen": "pnpm tsp:compile",
    "gen": "run-p gen:*",
    "gen:msr": "openapi-generator-cli generate -i ./openapi/msr.openapi.yaml -g typescript --additional-properties=platform=deno -o ./src/generated-msr/",
    "gen:core": "openapi-generator-cli generate -i ./openapi/core.openapi.yaml -g typescript --additional-properties=platform=deno -o ./src/generated-core/"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@typespec/compiler": "^0.64.0",
    "@typespec/http": "^0.64.0",
    "@typespec/openapi": "^0.64.0",
    "@typespec/openapi3": "^0.64.0",
    "@openapitools/openapi-generator-cli": "^2.13.7",
    "npm-run-all": "^4.1.5"
  },
  "exports": {
    "./models/*": {
      "import": "./src/generated-core/models/*"
    },
    "./api/*": {
      "import": "./src/generated-orw/*"
    }
  }
}