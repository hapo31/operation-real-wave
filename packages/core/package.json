{
  "name": "core",
  "scripts": {
    "start": "deno task start",
    "dev": "deno task watch",
    "openapi": "openapi-generator-cli",
    "deno": "deno",
    "tsp": "tsp",
    "tsp:compile": "tsp compile ./tsp/msr.tsp --options \"@typespec/openapi3.output-file=msr.openapi.yaml\" --config ./tspconfig.yaml",
    "pregen": "pnpm tsp:compile",
    "gen": "openapi-generator-cli generate -i ./.openapi/msr.openapi.yaml -g typescript --additional-properties=platform=deno -o ./src/generated-msr/"
  },
  "dependencies": {
    "@trpc/server": "11.0.0-rc.748",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.7",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@typespec/compiler": "^0.64.0",
    "@typespec/http": "^0.64.0",
    "@typespec/openapi": "^0.64.0",
    "@typespec/openapi3": "^0.64.0",
    "npm-run-all": "^4.1.5"
  },
  "exports": {
    "./model/*": {
      "types": "./src/model/*"
    },
    "./api/*": {
      "import": "./src/generated-orw/*"
    },
    "./trpc": {
      "import": "./index.ts"
    },
    "./trpc/init": {
      "import": "./src/trpc/init.ts"
    }
  }
}