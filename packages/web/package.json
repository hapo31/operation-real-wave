{
  "name": "web",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "deploy": "deployctl deploy --prod --include=build,public --project=<your deno deploy project> ./build/index.js",
    "dev": "remix vite:dev",
    "start": "remix^serve build",
    "format": "deno fmt --ignore=node_modules,build,public/build",
    "lint": "deno lint --ignore=node_modules,build,public/build"
  },
  "dependencies": {
    "@remix-run/node": "^2.12.1",
    "@remix-run/react": "^2.12.1",
    "@remix-run/serve": "^2.12.1",
    "@remix-run/server-runtime": "^2.12.1",
    "@vanilla-extract/css": "^1.15.3",
    "isbot": "^4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remix-typedjson": "^0.4.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.12.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.21.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.7",
    "vitest": "^2.1.1",
    "core": "workspace:*"
  },
  "engines": {
    "node": ">=14"
  }
}
